# Copy this file to .env and fill in your values
# cp .env.example .env

# ==============================================================================
# Database
# ==============================================================================
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/multitenant

# ==============================================================================
# Redis
# ==============================================================================
REDIS_URL=redis://localhost:6379

# ==============================================================================
# Auth
# ==============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==============================================================================
# AI / LLM config
# CHAT_MODEL routes chat + document metadata: anthropic | gemini | bedrock
# EMBEDDING_MODEL is the fastembed Hugging Face model.
# ==============================================================================
CHAT_MODEL=anthropic
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
GEMINI_API_KEY=
OPENAI_API_KEY=

# ==============================================================================
# S3 (leave empty to use local filesystem in dev)
# ==============================================================================
S3_BUCKET=
S3_REGION=us-east-1

# ==============================================================================
# Google OAuth 
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_APP_URL=http://localhost:3000
GOOGLE_REDIRECT_URI=

# ==============================================================================
# Agents service (src/agents only)
# URL of the server for internal API calls
# ==============================================================================
SERVER_URL=http://localhost:8000

# ==============================================================================
# App
# ==============================================================================
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOCAL_UPLOAD_DIR=/tmp/uploads
AUTH_GATEWAY_PROXY_ORIGIN=http://localhost:8000
API_BACKEND_ORIGIN=http://localhost:8000

# ==============================================================================
# Prompt management
# ==============================================================================
DEFAULT_PROMPT_WORKFLOW=default

# Langfuse - optional, for LLM call tracing only
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ==============================================================================
# Anthropic - used for BOTH chat (CHAT_MODEL=anthropic) and Claude Skills.
# Use a long-term key from the Claude Platform on AWS console (never expires).
# Skills API is NOT available via Bedrock - requires this direct Anthropic key.
# ==============================================================================
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_WORKSPACE_ID=
CLAUDE_SKILLS_COST_SEG_ID=
CLAUDE_SKILLS_COST_SEG_VERSION=latest
CLAUDE_SKILLS_MODEL=claude-3-haiku-20240307

# ==============================================================================
# Stripe implementation
# ==============================================================================
STRIPE_API_KEY=
STRIPE_COST_SEG_PRODUCT_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_COST_SEG_PRICE_ID=
STRIPE_COST_SEG_PRICE_MAPPING=
# PUBLIC_APP_URL= Already implemented above.

# ==============================================================================
# Email Configuration (AWS SES)
# ==============================================================================
ENABLE_EMAILS=False
EMAIL_FROM="kolmio@yourdomain.com"