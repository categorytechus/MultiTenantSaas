# Production environment variables for the EC2 app server.
# Copy this file to infra/prod.env and fill in the real values.
# infra/prod.env is gitignored — never commit it.
#
# After editing, push to EC2 with:
#   make upload-env

# ── ECR registry (from: terraform -chdir=infra output ecr_registry) ──────────
ECR_REGISTRY=<account-id>.dkr.ecr.us-east-1.amazonaws.com
IMAGE_TAG=latest

# ── Database (from: terraform -chdir=infra output -raw database_url) ──────────
DATABASE_URL=postgresql+psycopg://appuser:PASSWORD@<rds-host>:5432/app

# ── Redis (from: terraform -chdir=infra output redis_url) ────────────────────
REDIS_URL=redis://<elasticache-host>:6379/0

# ── S3 (from: terraform -chdir=infra output s3_bucket) ───────────────────────
S3_BUCKET=mtsaas-prod-uploads-<account-id>
AWS_DEFAULT_REGION=us-east-1

# ── Secret key (generate with: openssl rand -hex 32) ─────────────────────────
SECRET_KEY=

# ── AI keys ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=          # primary chat model (gemini-2.5-flash)
OPENAI_API_KEY=          # document embeddings
# ANTHROPIC_API_KEY=     # optional alternative for chat
