# Production environment variables for the EC2 app server.
# Copy this file to infra/prod.env and fill in the real values.
# infra/prod.env is gitignored — never commit it.
#
# After editing, push to EC2 with:
#   make upload-env

# ── ECR (from: terraform -chdir=infra output ecr_registry) ───────────────────
ECR_REGISTRY=<account-id>.dkr.ecr.us-east-1.amazonaws.com
IMAGE_TAG=latest

# ── Database (from: terraform -chdir=infra output -raw database_url) ──────────
DATABASE_URL=postgresql+psycopg://appuser:PASSWORD@<rds-host>:5432/app

# ── Redis (from: terraform -chdir=infra output redis_url) ────────────────────
REDIS_URL=redis://<elasticache-host>:6379/0

# ── S3 (EC2 IAM role provides credentials — no access keys needed) ────────────
S3_BUCKET=mtsaas-prod-uploads-<account-id>
AWS_DEFAULT_REGION=us-east-1

# ── Secret key (generate with: openssl rand -hex 32) ─────────────────────────
SECRET_KEY=

# ── Anthropic — long-term key from Claude Platform on AWS (never expires) ──────
# Used for BOTH chat (CHAT_MODEL=anthropic) AND Claude Skills report generation.
CHAT_MODEL=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://aws-external-anthropic.us-east-1.api.aws
ANTHROPIC_WORKSPACE_ID=
CLAUDE_SKILLS_COST_SEG_ID=
CLAUDE_SKILLS_COST_SEG_VERSION=latest
CLAUDE_SKILLS_MODEL=claude-sonnet-4-6

# ── Other AI keys (optional) ──────────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
